{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage 1 project runtime schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "project_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "region": {
      "type": "string"
    },
    "enabled_apis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "region",
    "enabled_apis"
  ]
}
