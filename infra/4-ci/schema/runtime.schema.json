{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage 4 CI runtime schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "region": {
      "type": "string"
    },
    "repo_owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider": {
      "type": "string"
    },
    "trigger_mode": {
      "type": "string"
    },
    "manage_triggers": {
      "type": "boolean"
    },
    "repo_name": {
      "type": "string"
    },
    "main_branch": {
      "type": "string"
    },
    "pull_request_target_branch": {
      "type": "string"
    },
    "triggers_enabled": {
      "type": "boolean"
    },
    "manual_approval_required": {
      "type": "boolean"
    },
    "included_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "region",
    "repo_name",
    "provider",
    "trigger_mode",
    "manage_triggers",
    "main_branch",
    "pull_request_target_branch",
    "triggers_enabled",
    "manual_approval_required",
    "included_paths",
    "excluded_paths"
  ]
}
