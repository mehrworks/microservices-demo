{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/microservices-demo/job-control/job-store-update.schema.json",
  "title": "Job store update",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "expected_revision"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "progress_percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "status_message": {
      "type": "string"
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "cancel_requested": {
      "type": "boolean"
    },
    "lease": {
      "oneOf": [
        {
          "$ref": "./lease.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "result_access": {
      "oneOf": [
        {
          "$ref": "./result-access-record.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
