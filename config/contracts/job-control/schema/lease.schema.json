{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/microservices-demo/job-control/lease.schema.json",
  "title": "Job lease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lease_id",
    "issued_at",
    "lease_expires_at",
    "lease_duration_seconds"
  ],
  "properties": {
    "lease_id": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "lease_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "lease_duration_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "renew_after_seconds": {
      "type": "integer",
      "minimum": 1
    }
  }
}
