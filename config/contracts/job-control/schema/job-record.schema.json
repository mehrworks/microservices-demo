{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/microservices-demo/job-control/job-record.schema.json",
  "title": "Job record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "job_type",
    "submitted_by",
    "state",
    "submitted_at",
    "updated_at",
    "payload"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "job_type": {
      "type": "string",
      "minLength": 1
    },
    "submitted_by": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "progress_percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "status_message": {
      "type": "string"
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "claimed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "claimed_by_auth_subject": {
      "type": [
        "string",
        "null"
      ]
    },
    "lease": {
      "oneOf": [
        {
          "$ref": "./lease.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "cancel_requested": {
      "type": "boolean"
    },
    "payload": {
      "type": "object"
    },
    "result_ref": {
      "oneOf": [
        {
          "$ref": "./result-reference.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
