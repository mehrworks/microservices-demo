  "title": "Project adopt-existing bind",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "project_number": {
      "type": [
        "string",
        "null"
      ]
    },
    "region": {
      "type": "string"
    },
    "enabled_apis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
