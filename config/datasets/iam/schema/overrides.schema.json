{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IAM overrides",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "region": {
      "type": [
        "string",
        "null"
      ]
    },
    "service_accounts": {
      "$ref": "#/defs/serviceAccounts"
    },
    "service_account_project_roles": {
      "$ref": "#/defs/serviceAccountRoles"
    }
  },
  "defs": {
    "serviceAccounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deployer": {
          "$ref": "#/defs/serviceAccount"
        },
        "runtime": {
          "$ref": "#/defs/serviceAccount"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "account_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "serviceAccountRoles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deployer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runtime": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
