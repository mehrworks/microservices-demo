{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Profile bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "datasets"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "datasets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "iam",
        "gke",
        "ci"
      ],
      "properties": {
        "project": {
          "type": "string"
        },
        "iam": {
          "type": "string"
        },
        "gke": {
          "type": "string"
        },
        "ci": {
          "type": "string"
        }
      }
    }
  }
}
